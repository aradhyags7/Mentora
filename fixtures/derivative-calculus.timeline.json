    "zoom": 1.0
  },
  "initialEntities": [
    {
      "id": "graph_deriv",
      "type": "graph",
      "title": "f(x) = 0.5x² - 2",
      "fnLatex": "0.5*x^2 - 2",
      "rangeX": [-4, 4],
      "rangeY": [-4, 6],
      "points": [
        { "x": 2, "y": 0, "label": "x₀ = 2", "color": "#2563EB" }
      ],
      "tangentAtX": 2
    },
    {
      "id": "card_calc_status",
      "type": "card",
      "title": "Calculus Invariants",
      "subtitle": "Point: (2.0, 0.0)",
      "theme": "default",
      "items": [
        { "label": "f(x)", "value": "0.5x² - 2" },
        { "label": "x₀", "value": "2.0" },
        { "label": "Secant Slope", "value": "Δy / Δx" },
        { "label": "Instant Slope", "value": "f'(2) = 2.0" }
      ]
    },
    {
      "id": "eq_deriv_def",
      "type": "equation",
      "latex": "f'(x) = \\lim_{\\Delta x \\to 0} \\frac{f(x + \\Delta x) - f(x)}{\\Delta x}",
      "explanation": "The formal limit definition of the derivative"
    }
  ],
  "cues": [
    {
      "id": "cue_d1",
      "timestampMs": 0,
      "durationMs": 5000,
      "narration": "What does a derivative actually mean? Instead of memorizing power rules, imagine finding the exact speedometer reading at a single instant in time.",
      "words": [
        { "word": "What", "startOffsetMs": 0, "endOffsetMs": 400 },
        { "word": "does", "startOffsetMs": 400, "endOffsetMs": 700 },
        { "word": "a", "startOffsetMs": 700, "endOffsetMs": 900 },
        { "word": "derivative", "startOffsetMs": 900, "endOffsetMs": 1500 },
        { "word": "actually", "startOffsetMs": 1500, "endOffsetMs": 2100 },
        { "word": "mean?", "startOffsetMs": 2100, "endOffsetMs": 2700 },
        { "word": "Imagine", "startOffsetMs": 2700, "endOffsetMs": 3300 },
        { "word": "instantaneous", "startOffsetMs": 3300, "endOffsetMs": 4200 },
        { "word": "speed.", "startOffsetMs": 4200, "endOffsetMs": 5000 }
      ],
      "actions": [
        {
          "type": "callout:show",
          "callout": {
            "id": "callout_curve",
            "type": "callout",
            "shape": "bracket",
            "color": "#2563EB",
            "strokeWidth": 2,
            "targetEntityId": "graph_deriv"
          }
        }
      ]
    },
    {
      "id": "cue_d2",
      "timestampMs": 5000,
      "durationMs": 6500,
      "narration": "On any smooth curve, average slope between two points is rise over run: delta y divided by delta x.",
      "actions": [
        { "type": "callout:clear" },
        {
          "type": "camera",
          "panX": 0,
          "panY": -15,
          "zoom": 1.15,
          "durationMs": 700,
          "easing": "easeOut"
        },
        {
          "type": "callout:show",
          "callout": {
            "id": "callout_pt",
            "type": "callout",
            "shape": "circle",
            "color": "#2563EB",
            "strokeWidth": 2.5,
            "targetEntityId": "graph_deriv"
          }
        }
      ]
    },
    {
      "id": "cue_d3",
      "timestampMs": 11500,
      "durationMs": 7500,
      "narration": "Now watch what happens as delta x shrinks toward zero. The secant line tilts closer and closer until it becomes the tangent line, kissing the curve at exactly one point.",
      "actions": [
        { "type": "callout:clear" },
        {
          "type": "graph:set_tangent",
          "targetId": "graph_deriv",
          "tangentAtX": 2
        },
        {
          "type": "equation:update_latex",
          "targetId": "eq_deriv_def",
          "latex": "\\left. \\frac{d}{dx}(0.5x^2 - 2) \\right|_{x=2} = 2(0.5)(2) = 2.0",
          "highlights": [{ "symbolId": "slope", "color": "#EF4444" }]
        },
        {
          "type": "callout:show",
          "callout": {
            "id": "callout_tangent",
            "type": "callout",
            "shape": "arrow",
            "color": "#EF4444",
            "strokeWidth": 2.5,
            "targetEntityId": "graph_deriv"
          }
        }
      ]
    },
    {
      "id": "cue_d4",
      "timestampMs": 19000,
      "durationMs": 9000,
      "narration": "At x = 2, the instantaneous slope is exactly 2.0. If you nudged x forward by 0.01, y would rise by roughly 0.02. That ratio is the derivative.",
      "actions": [
        {
          "type": "camera",
          "panX": 20,
          "panY": -10,
          "zoom": 1.25,
          "durationMs": 600,
          "easing": "easeInOut"
        },
        {
          "type": "card:update",
          "targetId": "card_calc_status",
          "theme": "success",
          "items": [
            { "label": "Function", "value": "f(x) = 0.5x² - 2" },
            { "label": "Derivative f'(x)", "value": "x" },
            { "label": "At x = 2", "value": "Slope = 2.0" },
            { "label": "Status", "value": "Tangent Verified" }
          ]
        }
      ]
    }
  ]
